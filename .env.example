# Web3Forms API Key for contact form
# Get your free API key from https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Optional: Google Analytics tracking ID
VITE_GA_TRACKING_ID=your_google_analytics_id_here

# Optional: Site URL for meta tags
VITE_SITE_URL=https://your-domain.com